{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "奥半仙",
  "version": "0.1.0",
  "identifier": "com.onana.aobanxian",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "奥半仙",
        "width": 420,
        "height": 210,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnBottom": true,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "像素道士黄历桌面小组件",
    "copyright": "© 2026 JAyLIjX · MIT License",
    "windows": {
      "wix": {
        "language": [
          "zh-CN"
        ]
      }
    }
  },
  "mainBinaryName": "aobanxian"
}
