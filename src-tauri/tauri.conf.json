{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "奥半仙",
  "version": "0.4.1",
  "identifier": "com.onana.aobanxian",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "奥半仙",
        "width": 400,
        "height": 360,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnBottom": true,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "像素道士黄历桌面小组件",
    "copyright": "© 2026 KhalilLiJX · MIT License",
    "windows": {
      "wix": {
        "language": [
          "zh-CN"
        ]
      }
    },
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "mainBinaryName": "aobanxian",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzMTE4ODMxMDlCRTZDOTIKUldTU2JMNEpNWWdSUTNoOTVpeHZERDNscWNKQXc5TFhvSWkvN1RTN2oxNzh0cjQ5YjNxV1NHY2kK",
      "endpoints": [
        "https://github.com/KhalilLiJX/aobanxian/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
